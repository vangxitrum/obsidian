        <mxCell id="title" value="Love Reminder V1 - Merchant Catalog Data Model" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#3F2432;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Launch cities: Hà Nội (HN), Hồ Chí Minh City (HCM), Đà Nẵng (DN)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cities" value="&lt;b&gt;cities&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;UQ code : HN | HCM | DN&lt;br&gt;name, slug, active" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="areas" value="&lt;b&gt;administrative_areas&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;FK city_id → cities&lt;br&gt;FK parent_id → self&lt;br&gt;official_code, name, area_type, active" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="area_aliases" value="&lt;b&gt;administrative_area_aliases&lt;/b&gt;&lt;br&gt;FK area_id → administrative_areas&lt;br&gt;alias, normalized_alias, source&lt;br&gt;Supports legacy Vietnamese addresses" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="505" width="250" height="125" as="geometry" />
        </mxCell>

        <mxCell id="merchants" value="&lt;b&gt;merchants&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;UQ slug, canonical_domain&lt;br&gt;name, website_url, merchant_type&lt;br&gt;verification_status, status&lt;br&gt;first_seen_at, last_verified_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
