          <mxGeometry x="770" y="90" width="360" height="900" as="geometry" />
        </mxCell>
        <mxCell id="lane_product" value="Canonical Data and Product" style="swimlane;startSize=34;horizontal=0;container=1;pointerEvents=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="90" width="390" height="900" as="geometry" />
