        <mxCell id="1" parent="0" />
        <mxCell id="flow_title" value="Love Reminder V1 - Crawl, Review, and Publication Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#3F2432;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lane_source" value="Permitted Merchant Source" style="swimlane;startSize=34;horizontal=0;container=1;pointerEvents=0;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="320" height="900" as="geometry" />
