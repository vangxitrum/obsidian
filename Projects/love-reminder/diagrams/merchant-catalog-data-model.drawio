        <mxCell id="locations" value="&lt;b&gt;merchant_locations&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;FK merchant_id → merchants&lt;br&gt;FK city_id → cities&lt;br&gt;FK administrative_area_id → areas&lt;br&gt;raw_address, normalized_address&lt;br&gt;lat/lng, opening_hours, status" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="335" width="280" height="175" as="geometry" />
        </mxCell>
        <mxCell id="contacts" value="&lt;b&gt;merchant_contacts&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;FK merchant_id → merchants&lt;br&gt;FK location_id → locations (optional)&lt;br&gt;contact_type, raw_value&lt;br&gt;normalized_value, is_primary, verified_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
