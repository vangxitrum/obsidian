        </mxCell>

        <mxCell id="items" value="&lt;b&gt;catalog_items&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;FK merchant_id → merchants&lt;br&gt;item_type : gift | experience&lt;br&gt;title, category, image_url&lt;br&gt;status, first_seen_at, last_verified_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
