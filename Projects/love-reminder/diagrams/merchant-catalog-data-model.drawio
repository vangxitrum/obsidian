        <mxCell id="source_audit" value="&lt;b&gt;Source audit&lt;/b&gt;&lt;br&gt;Terms and robots policy&lt;br&gt;Rate limit and image rights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="lane_source"><mxGeometry x="55" y="80" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="merchant_site" value="&lt;b&gt;Merchant website / feed / API&lt;/b&gt;&lt;br&gt;Products, experiences, contacts, addresses, sales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="lane_source"><mxGeometry x="55" y="260" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="source_change" value="Price, stock, address, or promotion changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="lane_source"><mxGeometry x="55" y="500" width="220" height="80" as="geometry" /></mxCell>

        <mxCell id="scheduler" value="&lt;b&gt;River schedule&lt;/b&gt;&lt;br&gt;Due sources only&lt;br&gt;Per-host concurrency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lane_crawler"><mxGeometry x="65" y="80" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="fetch" value="&lt;b&gt;Fetch&lt;/b&gt;&lt;br&gt;Identify crawler&lt;br&gt;Respect Retry-After and limits&lt;br&gt;Conditional HTTP requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane_crawler"><mxGeometry x="65" y="250" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="parse" value="&lt;b&gt;Parse and normalize&lt;/b&gt;&lt;br&gt;Merchant, branch, contact&lt;br&gt;Gift/experience, offer, promotion&lt;br&gt;Vietnamese phone/address normalization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane_crawler"><mxGeometry x="65" y="440" width="220" height="130" as="geometry" /></mxCell>
